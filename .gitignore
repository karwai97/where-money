# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase per-project config. Not secret, but not this repo's to publish —
# fetch your own with `firebase apps:sdkconfig` (see README).
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Firestore rules tests and the launcher icon (Node, not part of the Dart workspace)
tools/firestore-rules/node_modules/
tools/launcher-icon/node_modules/

# The Worker (Node, not part of the Dart workspace)
worker/node_modules/
worker/.wrangler/
# The OpenAI key for local dev. The deployed key is a Worker secret.
worker/.dev.vars

# Firebase emulator
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Generated from lib/l10n/*.arb by `flutter pub get` and by every build, so it
# is build output rather than source. l10n.yaml says where it lands.
/lib/l10n/app_localizations*.dart
/l10n-untranslated.json

# Agent scratch: per-machine, per-session, and nothing to do with the app.
#
# Two things are deliberately not in this list. CONTEXT.md is the project's
# own vocabulary, referenced by CLAUDE.md and the ADRs. `.scratch/` is the
# issue tracker CLAUDE.md and docs/agents/issue-tracker.md both point at — the
# spec a change was written from, which a reviewer has to be able to open.
# Both stay tracked.
.claude/settings.local.json
.claude/*.local.json
# A second checkout of this repo, made by an agent to work off to one side.
.claude/worktrees/
*-handoff.md
