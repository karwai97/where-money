# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase per-project config. Not secret, but not this repo's to publish —
# fetch your own with `firebase apps:sdkconfig` (see README).
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Firestore rules tests (Node, not part of the Dart workspace)
tools/firestore-rules/node_modules/

# The Worker (Node, not part of the Dart workspace)
worker/node_modules/
worker/.wrangler/
# The OpenAI key for local dev. The deployed key is a Worker secret.
worker/.dev.vars

# Firebase emulator
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Generated from lib/l10n/*.arb by `flutter pub get` and by every build, so it
# is build output rather than source. l10n.yaml says where it lands.
/lib/l10n/app_localizations*.dart
/l10n-untranslated.json
