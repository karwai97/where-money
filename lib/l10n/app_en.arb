  "reviewFindingNotAReceiptTitle": "Not a receipt",
  "@reviewFindingNotAReceiptTitle": {
    "description": "Each of the seventeen kinds of Finding the Check can raise gets two messages: a short title, and the sentence under it. Both halves matter — in a list of Findings the bold title above an explanation is doing real work, and a two-to-four-word title translates far more reliably than the sentence beneath it. Every number and every value read off the receipt is a placeholder, so each language puts it where that language puts it. Money placeholders are Strings, already formatted to two decimal places, because an amount is deliberately not locale-formatted."
  },
  "reviewFindingNotAReceiptDetail": "The model says this image is not a receipt.",

  "reviewFindingNoTotalTitle": "No total",
  "reviewFindingNoTotalDetail": "Total is zero or negative — nothing usable was read.",

  "reviewFindingNoMerchantTitle": "No merchant",
  "reviewFindingNoMerchantDetail": "Merchant name was not legible. The expense is unattributable.",

  "reviewFindingNoDateTitle": "No date",
  "reviewFindingNoDateDetail": "The date on the receipt was not legible — it will default to today.",

  "reviewFindingUnparseableDateTitle": "Unparseable date",
  "reviewFindingUnparseableDateDetail": "Got \"{read}\", which is not an ISO date.",
  "@reviewFindingUnparseableDateDetail": {
    "placeholders": {
      "read": { "type": "String" }
    }
  },

  "reviewFindingDateInTheFutureTitle": "Date in the future",
  "reviewFindingDateInTheFutureDetail": "Read {read}, which has not happened yet — probably a card expiry or a best-before date rather than the purchase.",
  "@reviewFindingDateInTheFutureDetail": {
    "placeholders": {
      "read": { "type": "String" }
    }
  },

  "reviewFindingYearLooksMisreadTitle": "Year looks misread",
  "reviewFindingYearLooksMisreadDetail": "Read {read}, almost exactly a year ago. On a freshly photographed receipt that usually means the year was misread — {likelyYear} is the likely value.",
  "@reviewFindingYearLooksMisreadDetail": {
    "description": "A year is a label, not a quantity, so it carries no grouping separator in any language.",
    "placeholders": {
      "read": { "type": "String" },
      "likelyYear": { "type": "int" }
    }
  },

  "reviewFindingDateIsUnusuallyOldTitle": "Date is unusually old",
