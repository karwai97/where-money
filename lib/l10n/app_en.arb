    }
  },

  "reviewFindingLineItemsDoNotMatchSubtotalTitle": "Line items do not match subtotal",
  "@reviewFindingLineItemsDoNotMatchSubtotalTitle": {
    "description": "One kind, four whole messages: the sum can fall short of the target or exceed it, and the target can be the subtotal or the total. Naming the target with a placeholder would be a translated fragment glued into a sentence, which is the thing the message files exist to stop."
  },
