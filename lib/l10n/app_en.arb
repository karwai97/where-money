  "@reviewFindingDateIsUnusuallyOldDetail": {
    "placeholders": {
      "read": { "type": "String" },
      "daysAgo": { "type": "int" }
    }
  },

  "reviewFindingCurrencyUnclearTitle": "Currency unclear",
  "@reviewFindingCurrencyUnclearTitle": {
    "description": "Two kinds share this title — nothing read where a currency belonged, and something read that is not an ISO 4217 code. They differ in what went wrong and not in what the user has to do about it, so they say the same thing above two different sentences."
  },
  "reviewFindingNoCurrencyDetail": "No currency identified, so the amount has no unit.",
